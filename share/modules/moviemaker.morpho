/* ***************************************************************
 * MovieMaker
 * ==========
 * Library to create movies from images.
 **************************************************************** */

import povray

/* ----------------------------------------------------------------
 * MovieMaker
 *
 * Creates a movie `fname`. Usage:
 * - frame(g) renders a single frame from the Graphics object `g`
 * - make() creates the movie using ffmpeg
 * - clean() removes the temporary files created by frame()
 * ---------------------------------------------------------------- */

class MovieMaker {
  init(fname, framerate=30, camera=nil) {
    self.fname=fname
    self.count=0
    self.quiet=true
    self.framerate = framerate
    self.camera = isnil(camera) ? Camera() : camera
  }

  _frameCamera(camera, lights) {
    var base = isnil(camera) ? self.camera : camera
    var cam = Camera(antialias=base.antialias, width=base.width, height=base.height,
                     viewangle=base.viewangle, viewpoint=base.viewpoint,
                     look_at=base.look_at, sky=base.sky)
    cam.light = isnil(lights) ? base.light : lights
    return cam
  }

  frame(g, camera=nil, lights=nil, shadowless=false, transparent=false) {
    var pov = POVRaytracer(g, camera=self._frameCamera(camera, lights))
    pov.render("${self.fname}${self.count}.pov", display=false, quiet=self.quiet,
               shadowless=shadowless, transparent=transparent)
    self.count+=1
  }

  make() {
    system("ffmpeg -y -r ${self.framerate} -i ${self.fname}%d.png -pix_fmt yuv420p ${self.fname}.mp4")
  }

  _remove(pattern) { // Delete frame files; del on Windows, rm elsewhere
    if (System.platform()=="windows") {
      system("del /f /q ${Folder.normalizePath(pattern)} >nul 2>&1")
    } else system("rm -f ${pattern}")
  }

  clean() {
    self._remove("${self.fname}*.png")
    self._remove("${self.fname}*.pov")
  }
}
